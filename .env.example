# Host-oriented defaults for local development (uvicorn/pytest outside Compose).
# docker-compose.yml overrides container DNS (db, redis, minio:9000, ai-runtime).
# Copy to .env and fill Google/Vertex secrets before `docker compose up`.

# ── Environment domain (Compose only) ──────────────────────
# Single source of truth for which UHIS backend this deployment talks to.
# SPICE_AUTH_BASE_URL and MICROCOACHING_STORAGE_PUBLIC_ENDPOINT (in
# docker-compose.yml) both fall back to this when unset, so pointing this
# whole stack at a different environment is one var, not a hunt through
# every place the domain was hardcoded (see the 2026-10-14 incident where
# SPICE_AUTH_BASE_URL silently pointed at a different domain's auth-service
# and 401'd every authenticated route).
UHIS_BACKEND_BASE_URL=https://uhis-dev-backend.labsplatform.com

# ── Database ──────────────────────────────────────────────
# MICROCOACHING_DATABASE_URL / MICROCOACHING_DATABASE_PASSWORD are preferred —
# bare DATABASE_URL / DATABASE_PASSWORD collide with the same vars in sibling
# Leapfrog services (e.g. leapfrog-ai-services) when their envs are merged.
# Old bare names still accepted as a fallback alias.
MICROCOACHING_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:15432/microcoaching
MICROCOACHING_DATABASE_PASSWORD=postgres
REDIS_URL=redis://localhost:16379/0

# ── AI Runtime (platform → ai-runtime) ────────────────────
AI_RUNTIME_BASE_URL=http://localhost:18001
AI_RUNTIME_TOKEN=dev-internal-token
AI_RUNTIME_TIMEOUT_SECONDS=600
AI_RUNTIME_TRANSCRIBE_TIMEOUT_SECONDS=600

# ── AI Cloud Provider (ai-runtime only) ───────────────────
AI_CLOUD_PROVIDER=google

# ── Google: Vertex AI (preferred for service-account auth) ───
# Set GOOGLE_USE_VERTEX=true and provide the four GOOGLE_CLOUD_*
# values below. GOOGLE_API_KEY is ignored when Vertex is enabled.
GOOGLE_USE_VERTEX=true
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=us-central1
# Path to the service-account JSON inside the ai-runtime container.
# Leave this at the default; set GCP_SERVICE_ACCOUNT_JSON_HOST_PATH
# below to the host path so docker-compose bind-mounts it here.
# MICROCOACHING_GOOGLE_APPLICATION_CREDENTIALS is the preferred name when
# running outside Compose (bare uvicorn/pytest) — bare
# GOOGLE_APPLICATION_CREDENTIALS collides with the same var in sibling
# Leapfrog services (e.g. leapfrog-ai-services) if their envs are merged.
# The Google SDK reads GOOGLE_APPLICATION_CREDENTIALS directly, so both
# main.py entrypoints copy the MICROCOACHING_-prefixed value over it at
# startup (see apply_microcoaching_google_credentials_alias).
MICROCOACHING_GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-service-account.json
# Host-side path to the same JSON file — overridden by docker-compose.
# Required when GOOGLE_USE_VERTEX=true; left unset compose still starts
# cleanly but the first LLM call will fail with a clear auth error.
GCP_SERVICE_ACCOUNT_JSON_HOST_PATH=/path/to/your/gcp-service-account.json
# Optional: base64-encoded service-account JSON (skips the bind-mount).
GOOGLE_SERVICE_ACCOUNT_BASE64=

# ── Google: Developer API (api-key auth, fallback) ───────────
# Used only when GOOGLE_USE_VERTEX is false.
GOOGLE_API_KEY=
# MICROCOACHING_GEMINI_API_KEY is the preferred alias — bare GEMINI_API_KEY
# collides with the same var in sibling Leapfrog services (e.g.
# leapfrog-ai-services) when their envs are merged. Compose fallback chain:
# ${GOOGLE_API_KEY:-${MICROCOACHING_GEMINI_API_KEY:-${GEMINI_API_KEY:-}}}
MICROCOACHING_GEMINI_API_KEY=
GEMINI_API_KEY=

# ── Google: embedding model (ai-runtime only) ────────────────
# Generate models and per-GenerationType budgets live in
# ai_runtime.generation_profiles (code defaults). Deploy ai-runtime
# before platform when cutting over.
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001

# ── Local embeddings (ai-runtime only, use_local=true on /internal/embed) ─
# Accept the EmbeddingGemma license on Hugging Face before first use.
LOCAL_EMBEDDING_MODEL=google/embeddinggemma-300m
LOCAL_EMBEDDING_DEVICE=cpu
HUGGINGFACE_TOKEN=

# ── Local generation (ai-runtime only, use_local=true on /internal/generate) ─
# GGUF via llama-cpp-python (CPU wheel on Linux, Metal on macOS).
# GGUF model — set LOCAL_GENERATION_GGUF_PATH to a local file, or use repo+file for HF download:
# LOCAL_GENERATION_GGUF_PATH=/path/to/model.gguf
LOCAL_GENERATION_GGUF_REPO=Qwen/Qwen3-0.6B-GGUF
LOCAL_GENERATION_GGUF_FILE=Qwen3-0.6B-Instruct-Q4_K_M.gguf
LOCAL_GENERATION_N_CTX=32768
# LOCAL_GENERATION_N_THREADS=8
LOCAL_GENERATION_N_BATCH=512
LOCAL_GENERATION_MAX_INPUT_TOKENS=20000
LOCAL_PRELOAD_ON_STARTUP=true
JSON_PARSE_RETRIES_LOCAL=0

# ── Embedding (platform assert + ai-runtime align) ───────────
EMBEDDING_DIMENSION=768
TOP_K=5
# Durable vector backend behind mc_foundation.VectorStore.
# Only ``pgvector`` is implemented today (vectors on module.embedding).
VECTOR_STORE_BACKEND=pgvector

# ── Logging ──────────────────────────────────────────────
# Wired into compose as `log_level` for platform-api, celery worker/beat, ai-runtime.
# Distinct from celery CLI `--loglevel`. Set DEBUG for app logger.debug lines.
LOG_LEVEL=INFO
LOG_JSON=true
APP_ENV=development
# Unset = stdout only (pytest/CI). Compose sets /var/log/microcoaching and
# bind-mounts ./logs so typed files survive container restarts.
# MICROCOACHING_LOG_DIR is preferred — bare LOG_DIR collides with the same
# var in sibling Leapfrog services (e.g. leapfrog-ai-services) when their
# envs are merged. Old bare name still accepted as a fallback alias.
# MICROCOACHING_LOG_DIR=/var/log/microcoaching
LOG_MAX_BYTES=50000000
LOG_BACKUP_COUNT=10

# ── SPICE auth-service (platform token validation) ─────────
# When true, every platform-api route (except ready) requires a valid
# SPICE JWT validated via POST {SPICE_AUTH_BASE_URL}/authenticate.
# Compose wires the four keys below (default off for local).
SPICE_AUTH_ENABLED=false
# Auth-service root: direct (http://authservice:8089) or nginx proxy
# (http://gateway/auth-service). No trailing slash.
# Host: localhost; Compose default for containers: host.docker.internal.
# Pointing at a shared dev backend instead of a local auth-service? Use that
# backend's own /auth-service root (e.g. https://uhis-dev-backend.labsplatform.com/auth-service)
# — it must match whichever backend actually issued the token being validated,
# or every authenticated route 401s with "unable to authenticate" (see
# docker-compose.yml's spice_auth_base_url default/comment for the 2026-10-14
# incident this caused).
SPICE_AUTH_BASE_URL=http://localhost:8089
SPICE_AUTH_TIMEOUT_SECONDS=5.0
SPICE_AUTH_DEFAULT_CLIENT=mob
SPICE_AUTH_EXEMPT_PATHS=ready
# Role→route grants live in Postgres (api_route / role_route_access); seeded by Alembic.

# ── Platform service ─────────────────────────────────────
UPLOAD_DIR=/tmp/microcoaching/uploads

# ── Stage 2-draft — published-module merge tuning ───────────
# Stage D always attempts merge into a similar active (non-retired)
# published module (fusion drafts opt out internally).
STAGE_D_PUBLISHED_MERGE_PREFILTER_LIMIT=25
# Deterministic content gate: fraction of existing cards that must match
# the new card set (by text similarity or shared source_block_id).
STAGE_D_PUBLISHED_MERGE_MIN_EXISTING_CARD_MATCH_RATIO=0.0
# Per existing card, best new-card trigram similarity must exceed this.
STAGE_D_PUBLISHED_MERGE_CARD_SIMILARITY_THRESHOLD=0.0
# Whole-module fingerprint similarity floor (both card sets concatenated).
STAGE_D_PUBLISHED_MERGE_MODULE_SIMILARITY_THRESHOLD=0.0

# ── Post-publish — search metadata ─────────────────────────
POST_PUBLISH_SEARCH_METADATA_ENABLED=true
SEARCH_METADATA_MAX_KEYWORDS=15
SEARCH_METADATA_MAX_SEARCH_PHRASES=10
SEARCH_METADATA_MAX_SYNONYMS=10
SEARCH_METADATA_MAX_TAGS=10

# ── Chat FAQ mining (Celery beat / worker) ─────────────────
CHAT_FAQ_LOOKBACK_DAYS=90
CHAT_FAQ_MIN_OCCURRENCE_COUNT=3
CHAT_FAQ_MIN_QUESTION_LENGTH=5
CHAT_FAQ_TARGET_COUNT=6
CHAT_FAQ_MIN_OUTPUT_COUNT=5
CHAT_FAQ_CLUSTER_CANDIDATE_LIMIT=100
CHAT_FAQ_WEEKLY_HOUR_UTC=2
CHAT_FAQ_WEEKLY_DAY_OF_WEEK=0

# ── Chat feedback summary (Celery beat / worker) ───────────
CHAT_FEEDBACK_SUMMARY_WEEKLY_HOUR_UTC=3
CHAT_FEEDBACK_SUMMARY_WEEKLY_DAY_OF_WEEK=0
CHAT_FEEDBACK_SUMMARY_LLM_TIMEOUT_SECONDS=90
CHAT_FEEDBACK_SUMMARY_FIRST_RUN_LOOKBACK_DAYS=90
CHAT_FEEDBACK_SUMMARY_MAX_POSITIVE_ONLINE_SAMPLES=10
CHAT_FEEDBACK_SUMMARY_MAX_POSITIVE_OFFLINE_SAMPLES=10
CHAT_FEEDBACK_SUMMARY_MAX_NEGATIVE_ONLINE_SAMPLES=30
CHAT_FEEDBACK_SUMMARY_MAX_NEGATIVE_OFFLINE_SAMPLES=30

# ── Object storage ────────────────────────────────────────
# One provider switch plus settings that mean the same thing for every provider.
#   MICROCOACHING_STORAGE_PROVIDER         minio | s3 | gcs
#   MICROCOACHING_STORAGE_BUCKET           bucket name
#   MICROCOACHING_STORAGE_ENDPOINT         storage API URL. Required for minio; optional for s3
#                                          (AWS regional endpoint) and gcs (Google's). A bare host
#                                          means https; write http:// for a local MinIO.
#   MICROCOACHING_STORAGE_REGION           region (s3 / minio; default us-east-1)
#   MICROCOACHING_STORAGE_ACCESS_KEY       key pair. Leave BOTH empty to authenticate as the identity
#   MICROCOACHING_STORAGE_SECRET_KEY       attached to the workload (GCP service account / AWS role).
#   MICROCOACHING_STORAGE_PUBLIC_ENDPOINT  host browsers use in download links, when it is not the
#                                          endpoint itself (e.g. an nginx proxy in front of MinIO)
#   MICROCOACHING_STORAGE_CREATE_BUCKET    create the bucket if missing (minio only; default false)
#
# --- Local MinIO (the compose default) ---
# Compose maps host port 19902 to the MinIO S3 API (container 9000); the console is on 19001.
# Compose services use http://minio:9000 in-network; these host values are for running the
# platform outside Compose.
MICROCOACHING_STORAGE_PROVIDER=minio
MICROCOACHING_STORAGE_BUCKET=medtronics-storage
MICROCOACHING_STORAGE_ENDPOINT=http://localhost:19902
MICROCOACHING_STORAGE_ACCESS_KEY=microcoaching
MICROCOACHING_STORAGE_SECRET_KEY=microcoaching123
MICROCOACHING_STORAGE_CREATE_BUCKET=true
#
# --- Google Cloud Storage ---
# On GKE with Workload Identity nothing else is needed: the pod's service account authenticates
# data calls and signs download links. It needs object access on the bucket, bucket read
# (storage.buckets.get, for the readiness check) and roles/iam.serviceAccountTokenCreator on itself.
# MICROCOACHING_STORAGE_PROVIDER=gcs
# MICROCOACHING_STORAGE_BUCKET=your-bucket
# Outside GKE, or without Workload Identity, add an HMAC key pair for a service account:
# MICROCOACHING_STORAGE_ACCESS_KEY=
# MICROCOACHING_STORAGE_SECRET_KEY=
#
# --- AWS S3 ---
# Leave the keys empty to use the AWS credential chain (instance role, IRSA).
# MICROCOACHING_STORAGE_PROVIDER=s3
# MICROCOACHING_STORAGE_BUCKET=your-bucket
# MICROCOACHING_STORAGE_REGION=us-east-1
# Ops prerequisites for s3 and gcs: pre-create the bucket (the app never creates a cloud bucket);
# configure bucket CORS if browsers fetch download links directly.
ADMIN_FILE_ALLOWED_PREFIXES=uploads,source-documents,media,ingest,module-thumbnails
ADMIN_FILE_UPLOAD_PREFIX=uploads
ADMIN_FILE_PRESIGNED_MAX_SECONDS=86400

# ── Coaching RAG ───────────────────────────────────────────
COACHING_RAG_MODULE_LIMIT=5
COACHING_LOCAL_RAG_CARD_LIMIT=5
COACHING_RAG_PRESIGNED_URL_TTL_SECONDS=3600
COACHING_RAG_CONTEXT_MAX_CHARS=28000

# ── ClickHouse (platform only) ───────────────────────────
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=18123
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
# App-level retries for transient query/insert failures (1 = disable).
CLICKHOUSE_QUERY_MAX_ATTEMPTS=3
CLICKHOUSE_QUERY_RETRY_BACKOFF_MS=100

# ── Analytics dashboard (docker compose --profile dashboard) ─────────────
# Optional UI from micro-learning-analytics-dashboard. Build the image locally
# (see docker-compose.yml) or set ANALYTICS_DASHBOARD_BUILD_CONTEXT to that repo.
# ANALYTICS_DASHBOARD_IMAGE=micro-learning-analytics-dashboard:local
# ANALYTICS_DASHBOARD_PORT=18080
# ANALYTICS_DASHBOARD_BUILD_CONTEXT=../micro-learning-analytics-dashboard
# VITE_ADMIN_API_BASE_URL=http://localhost:18000
# VITE_USE_MOCK_API=false
# Skips the dashboard's cookie-based SPICE login check, seeding a fake test
# session instead. Dev/local only — never set true for a real deployment.
# Vite bakes this in at build time: changing it needs an image rebuild, not
# just a container restart.
# VITE_DEV_AUTH_BYPASS=false

# ── GitBook site (docker compose --profile docs-static) ──────────────────
# Optional MkDocs publish of docs/. Default stack does not start it.
#   docker compose --profile docs-static up docs-static --build
# Rebuild the image after you change markdown.
# DOCS_PORT=18081

# ── Safety ───────────────────────────────────────────────
RETRIEVAL_REQUIRE_VALIDATED=false
SPICE_REFERRAL_DESTINATIONS=Upazila Health Complex (UHC),Community Clinic,District Hospital,Union Health Centre,Mother and Child Welfare Centre (MCWC),Emergency Obstetric Care (EmOC),Nutrition Rehabilitation Unit (NRU),Upazila Health and Family Planning Officer (UHFPO),BRAC Health Programme Clinic
